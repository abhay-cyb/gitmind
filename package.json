{
  "name": "gitmind",
  "displayName": "GitMind",
  "description": "AI-powered Git debugging assistant for explaining breaking commits, merge conflicts, and code changes.",
  "version": "1.0.0",
  "publisher": "yv3000",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitmind.findBreakingCommit",
        "title": "GitMind: Find Breaking Commit"
      },
      {
        "command": "gitmind.explainConflict",
        "title": "GitMind: Explain This Conflict"
      },
      {
        "command": "gitmind.explainChanges",
        "title": "GitMind: Explain Changes"
      },
      {
        "command": "gitmind.setApiKey",
        "title": "GitMind: Set OpenRouter API Key"
      },
      {
        "command": "gitmind.refreshContext",
        "title": "GitMind: Refresh Context"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitmind-sidebar-container",
          "title": "GitMind",
          "icon": "media/gitmind.svg"
        }
      ]
    },
    "views": {
      "gitmind-sidebar-container": [
        {
          "type": "webview",
          "id": "gitmind.sidebar",
          "name": "GitMind Assistant"
        }
      ]
    },
    "configuration": {
      "title": "GitMind",
      "properties": {
        "gitmind.openrouterModel": {
          "type": "string",
          "default": "google/gemma-3-12b-it:free",
          "description": "Model to use for OpenRouter requests."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "webpack --mode production",
    "watch": "webpack --watch --mode development",
    "package": "vsce package"
  },
  "dependencies": {
    "simple-git": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^18.11.9",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.29.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  }
}
